@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div id="header-page" class="top-row px-4">
            <div>
                <button class="btn btn-outline-primary">Home</button>
                <button class="btn btn-outline-primary">Privacy</button>
                <button class="btn btn-outline-primary">Users</button>
                <button class="btn btn-outline-primary">About</button>
            </div>
            <div>
                <button class="btn btn-default">Login</button>
                <button class="btn btn-default">Profile</button>
                <button class="btn btn-default">Setting</button>
                <button class="btn btn-outline-danger">Logout</button>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
